{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "灵犀",
  "version": "0.2.0",
  "identifier": "com.lingxi.notes",
  "build": {
    "frontendDist": "./loading"
  },
  "app": {
    "windows": [
      {
        "title": "灵犀",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": {
      "../target/lingxi.jar": "target/lingxi.jar",
      "windows/模型放置说明.txt": "模型放置说明.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": true,
        "installerHooks": "windows/installer-hooks.nsh",
        "compression": "lzma"
      }
    }
  }
}
