<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.4.2</version>
        <relativePath/>
    </parent>

    <groupId>org.example</groupId>
    <artifactId>LLM_native_notebook</artifactId>
    <!-- 与桌面壳版本保持一致（tauri.conf.json / Cargo.toml 同为 0.2.0）：
         否则打出来的 jar 里 Implementation-Version 还是 SNAPSHOT，
         装进 0.2.0 的安装包里会显得是另一个版本。 -->
    <version>0.2.0</version>
    <name>lingxi</name>
    <description>灵犀：与你心有灵犀的 AI 笔记应用（LangChain4j）</description>

    <properties>
        <java.version>21</java.version>
        <langchain4j.version>1.22.0</langchain4j.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>dev.langchain4j</groupId>
                <artifactId>langchain4j-bom</artifactId>
                <version>${langchain4j.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- 模型接入：业务代码只依赖 LangChain4j 接口，provider 切换靠配置 -->
        <!-- langchain4j 主模块：AiServices / TokenStream / InMemoryEmbeddingStore / EmbeddingStoreContentRetriever -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <!-- 本地 ONNX 嵌入：OnnxEmbeddingModel（DJL 分词 + ONNX Runtime），版本由 BOM 管理（beta 线） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-embeddings</artifactId>
            <exclusions>
                <!-- 排除 CPU 版原生库：onnxruntime_gpu 是超集（内置 CPU EP），两 jar 同名原生库共存会冲突 -->
                <exclusion>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>onnxruntime</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- 本地 ONNX 重排：OnnxScoringModel（cross-encoder，配 bge-reranker） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-onnx-scoring</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>com.microsoft.onnxruntime</groupId>
                    <artifactId>onnxruntime</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <!-- ONNX Runtime（CPU 版）：JVM 侧只用 CPU EP。
             原来引的是 onnxruntime_gpu（551MB，自带 CUDA/cuDNN），但决策 14/15 已定：
             Windows 下 JVM 内加载 CUDA provider 必失败（DllMain 1114），GPU 重排只能走
             reranker-service/ 的 Python sidecar（那边自带 GPU runtime，与本 jar 无关）。
             也就是说这个 GPU jar 在分发版里是纯死重量——换 CPU 版后 jar 从 683MB 降到 ~215MB
             （CPU 版 88MB，省下 460MB 的 CUDA/cuDNN），安装包才装得下去。
             两个 langchain4j 依赖仍排除各自传递进来的 onnxruntime，由这里统一锁版本。 -->
        <dependency>
            <groupId>com.microsoft.onnxruntime</groupId>
            <artifactId>onnxruntime</artifactId>
            <version>1.20.0</version>
        </dependency>
        <!-- 多模态导入一级解析：Apache Tika（pdf/docx/pptx/html/txt... 统一文本抽取） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-document-parser-apache-tika</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-open-ai</artifactId>
        </dependency>
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-ollama</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>lingxi</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
